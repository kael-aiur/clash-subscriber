<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>site.kael.clash</groupId>
        <artifactId>clash-subscriber</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-web</artifactId>
    <packaging>jar</packaging>

    <name>module-web</name>
    <description>REST API 层：订阅管理、Mihomo 节点管理、配置推送接口</description>

    <dependencies>
        <!-- 内部模块：公共工具 -->
        <dependency>
            <groupId>site.kael.clash</groupId>
            <artifactId>module-common</artifactId>
        </dependency>

        <!-- 内部模块：订阅管理 -->
        <dependency>
            <groupId>site.kael.clash</groupId>
            <artifactId>module-subscription</artifactId>
        </dependency>

        <!-- 内部模块：配置处理 -->
        <dependency>
            <groupId>site.kael.clash</groupId>
            <artifactId>module-processor</artifactId>
        </dependency>

        <!-- 内部模块：Mihomo 管理 -->
        <dependency>
            <groupId>site.kael.clash</groupId>
            <artifactId>module-mihomo</artifactId>
        </dependency>

        <!-- 内部模块：定时任务 -->
        <dependency>
            <groupId>site.kael.clash</groupId>
            <artifactId>module-scheduler</artifactId>
        </dependency>

        <!-- 内部模块：构建流程 -->
        <dependency>
            <groupId>site.kael.clash</groupId>
            <artifactId>module-pipeline</artifactId>
        </dependency>

        <!-- Spring Boot Web Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
